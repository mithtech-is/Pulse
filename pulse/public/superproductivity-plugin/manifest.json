{
  "id": "pulse-sync",
  "name": "Pulse Sync",
  "version": "0.1.0",
  "manifestVersion": 1,
  "minSupVersion": "9.0.0",
  "description": "Import your assigned Pulse tasks and push tracked time back to Pulse.",
  "permissions": ["persistData"],
  "hooks": ["taskComplete", "finishDay"],
  "iFrame": true,
  "jsFiles": ["plugin.js"],
  "icon": "icon.svg"
}
